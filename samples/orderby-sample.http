### =====================================================
### Sorting Sample Requests ($orderby)
### Demonstrates sorting by fields, complex sub-fields and
### search.score(), where documents without a value go, how ties
### are broken, and the $orderby clauses Azure AI Search rejects.
### =====================================================
###
### SETUP ORDER:
### 1. Create the index
### 2. Upload the documents
### 3. Sort (each title gives the expected order, or the status)
### 4. Cleanup
###
### Prerequisites:
### - The simulator running at https://localhost:7250
### - REST Client extension for VS Code
### - For the [AZURE] requests: an Azure AI Search service with role-based
###   access, the Search Service Contributor and Search Index Data Contributor
###   roles, and AZURE_BASE_URL and ENTRA_TOKEN in .env (see .env.example).
###   To use keys instead, replace "Authorization: Bearer {{azureToken}}"
###   with an api-key header.
### - Each request is a [SIM]/[AZURE] pair; run the steps in order on each.
### =====================================================

@baseUrl = {{$dotenv BASE_URL}}
@apiVersion = {{$dotenv API_VERSION}}
@adminKey = {{$dotenv ADMIN_KEY}}
@queryKey = {{$dotenv QUERY_KEY}}
@azureBaseUrl = {{$dotenv AZURE_BASE_URL}}
@azureToken = {{$dotenv ENTRA_TOKEN}}

# =====================================================
# 1. CREATE THE INDEX
# =====================================================

### [SIM] Create an index with sortable simple and complex sub-fields
POST {{baseUrl}}/indexes?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "name": "orderby-sample",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": true },
    { "name": "name", "type": "Edm.String", "searchable": true, "sortable": true },
    { "name": "description", "type": "Edm.String", "searchable": true, "sortable": false },
    { "name": "category", "type": "Edm.String", "filterable": true, "sortable": true },
    { "name": "rating", "type": "Edm.Double", "sortable": true },
    { "name": "floors", "type": "Edm.Int32", "sortable": true },
    { "name": "tags", "type": "Collection(Edm.String)", "filterable": true },
    {
      "name": "address", "type": "Edm.ComplexType",
      "fields": [{ "name": "city", "type": "Edm.String", "sortable": true }]
    },
    {
      "name": "rooms", "type": "Collection(Edm.ComplexType)",
      "fields": [{ "name": "beds", "type": "Edm.Int32", "filterable": true }]
    }
  ]
}

### [AZURE] Create an index with sortable simple and complex sub-fields
POST {{azureBaseUrl}}/indexes?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "name": "orderby-sample",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": true },
    { "name": "name", "type": "Edm.String", "searchable": true, "sortable": true },
    { "name": "description", "type": "Edm.String", "searchable": true, "sortable": false },
    { "name": "category", "type": "Edm.String", "filterable": true, "sortable": true },
    { "name": "rating", "type": "Edm.Double", "sortable": true },
    { "name": "floors", "type": "Edm.Int32", "sortable": true },
    { "name": "tags", "type": "Collection(Edm.String)", "filterable": true },
    {
      "name": "address", "type": "Edm.ComplexType",
      "fields": [{ "name": "city", "type": "Edm.String", "sortable": true }]
    },
    {
      "name": "rooms", "type": "Collection(Edm.ComplexType)",
      "fields": [{ "name": "beds", "type": "Edm.Int32", "filterable": true }]
    }
  ]
}

# =====================================================
# 2. UPLOAD THE DOCUMENTS
# =====================================================

### [SIM] Upload four hotels (hotel 2 has no rating; hotel 4 has no floors; hotel 3 has int.MinValue floors)
POST {{baseUrl}}/indexes/orderby-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [
    {
      "@search.action": "upload", "id": "1", "name": "Alpine", "category": "a", "rating": 4.0, "floors": 3,
      "description": "A hotel in the mountains.", "address": { "city": "Zurich" }, "rooms": [{ "beds": 2 }]
    },
    {
      "@search.action": "upload", "id": "2", "name": "Bay", "category": "a", "floors": 10,
      "description": "A hotel by the bay, a quiet hotel with a hotel garden.", "address": { "city": "Amsterdam" }
    },
    {
      "@search.action": "upload", "id": "3", "name": "Coast", "category": "a", "rating": 5.0, "floors": -2147483648,
      "description": "A seaside hotel, the best hotel on the coast.", "address": { "city": "Lisbon" }
    },
    {
      "@search.action": "upload", "id": "4", "name": "Dune", "category": "b", "rating": 3.5,
      "description": "Rooms in the desert.", "address": { "city": "Berlin" }
    }
  ]
}

### [AZURE] Upload four hotels (hotel 2 has no rating; hotel 4 has no floors; hotel 3 has int.MinValue floors)
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "value": [
    {
      "@search.action": "upload", "id": "1", "name": "Alpine", "category": "a", "rating": 4.0, "floors": 3,
      "description": "A hotel in the mountains.", "address": { "city": "Zurich" }, "rooms": [{ "beds": 2 }]
    },
    {
      "@search.action": "upload", "id": "2", "name": "Bay", "category": "a", "floors": 10,
      "description": "A hotel by the bay, a quiet hotel with a hotel garden.", "address": { "city": "Amsterdam" }
    },
    {
      "@search.action": "upload", "id": "3", "name": "Coast", "category": "a", "rating": 5.0, "floors": -2147483648,
      "description": "A seaside hotel, the best hotel on the coast.", "address": { "city": "Lisbon" }
    },
    {
      "@search.action": "upload", "id": "4", "name": "Dune", "category": "b", "rating": 3.5,
      "description": "Rooms in the desert.", "address": { "city": "Berlin" }
    }
  ]
}

# =====================================================
# 3. SORT
# =====================================================

### [SIM] Ascending: documents without a value come first → in order: 2, 4, 1, 3
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "rating asc",
  "select": "id, rating"
}

### [AZURE] Ascending: documents without a value come first → in order: 2, 4, 1, 3
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "rating asc",
  "select": "id, rating"
}

### [SIM] Descending: documents without a value come last → in order: 3, 1, 4, 2
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "rating desc",
  "select": "id, rating"
}

### [AZURE] Descending: documents without a value come last → in order: 3, 1, 4, 2
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "rating desc",
  "select": "id, rating"
}

### [SIM] A missing number sorts before int.MinValue → in order: 4, 3, 1, 2
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "floors",
  "select": "id, floors"
}

### [AZURE] A missing number sorts before int.MinValue → in order: 4, 3, 1, 2
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "floors",
  "select": "id, floors"
}

### [SIM] A sortable sub-field of a complex field → in order: 2, 4, 3, 1
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "address/city asc",
  "select": "id, address/city"
}

### [AZURE] A sortable sub-field of a complex field → in order: 2, 4, 3, 1
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "address/city asc",
  "select": "id, address/city"
}

### [SIM] Several clauses → in order: 3, 2, 1, 4
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "category asc, name desc",
  "select": "id, category, name"
}

### [AZURE] Several clauses → in order: 3, 2, 1, 4
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "category asc, name desc",
  "select": "id, category, name"
}

### [SIM] search.score() descending: the best match first → in order: 2, 3, 1
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "hotel",
  "orderby": "search.score() desc",
  "select": "id"
}

### [AZURE] search.score() descending: the best match first → in order: 2, 3, 1
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "hotel",
  "orderby": "search.score() desc",
  "select": "id"
}

### [SIM] search.score() without a direction sorts ascending, like any field → in order: 1, 3, 2
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "hotel",
  "orderby": "search.score()",
  "select": "id"
}

### [AZURE] search.score() without a direction sorts ascending, like any field → in order: 1, 3, 2
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "hotel",
  "orderby": "search.score()",
  "select": "id"
}

### [SIM] Ties on the sort fields are broken by score, and results keep their @search.score → in order: 2, 3, 1
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "hotel",
  "orderby": "category asc",
  "select": "id, category"
}

### [AZURE] Ties on the sort fields are broken by score, and results keep their @search.score → in order: 2, 3, 1
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "hotel",
  "orderby": "category asc",
  "select": "id, category"
}

# =====================================================
# 4. CLAUSES AZURE REJECTS (HTTP 400)
# =====================================================

### [SIM] A field that isn't sortable → 400
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "description asc"
}

### [AZURE] A field that isn't sortable → 400
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "description asc"
}

### [SIM] A collection → 400
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "tags asc"
}

### [AZURE] A collection → 400
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "tags asc"
}

### [SIM] A complex field → 400
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "address asc"
}

### [AZURE] A complex field → 400
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "address asc"
}

### [SIM] A path through a complex collection → 400
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "rooms/beds asc"
}

### [AZURE] A path through a complex collection → 400
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "rooms/beds asc"
}

### [SIM] An unknown field → 400
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "stars desc"
}

### [AZURE] An unknown field → 400
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "stars desc"
}

### [SIM] A direction other than asc or desc → 400
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "rating up"
}

### [AZURE] A direction other than asc or desc → 400
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "rating up"
}

### [SIM] An empty clause → 400
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "rating asc,"
}

### [AZURE] An empty clause → 400
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "rating asc,"
}

### [SIM] More than 32 clauses → 400
POST {{baseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "orderby": "name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name"
}

### [AZURE] More than 32 clauses → 400
POST {{azureBaseUrl}}/indexes/orderby-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "orderby": "name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name, name"
}

# =====================================================
# 5. CLEANUP
# =====================================================

### [SIM] Delete the index
DELETE {{baseUrl}}/indexes/orderby-sample?api-version={{apiVersion}}
api-key: {{adminKey}}

### [AZURE] Delete the index
DELETE {{azureBaseUrl}}/indexes/orderby-sample?api-version={{apiVersion}}
Authorization: Bearer {{azureToken}}
