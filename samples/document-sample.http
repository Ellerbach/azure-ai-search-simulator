### =====================================================
### Document Sample Requests
### Demonstrates how documents are written and returned: batch
### validation (an invalid action rejects the whole batch before
### anything is written), how values are converted to their field's
### type, merges into complex fields, and the shape of looked-up
### documents.
### =====================================================
###
### SETUP ORDER:
### 1. Create the index
### 2. Upload, look up and merge documents
### 3. Batches Azure rejects
### 4. Cleanup
###
### Prerequisites:
### - The simulator running at https://localhost:7250
### - REST Client extension for VS Code
### =====================================================

@baseUrl = {{$dotenv BASE_URL}}
@apiVersion = {{$dotenv API_VERSION}}
@adminKey = {{$dotenv ADMIN_KEY}}
@queryKey = {{$dotenv QUERY_KEY}}

# =====================================================
# 1. CREATE THE INDEX
# =====================================================

### Create an index with one field of each kind
POST {{baseUrl}}/indexes?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "name": "document-sample",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": true },
    { "name": "name", "type": "Edm.String", "searchable": true },
    { "name": "rating", "type": "Edm.Double", "filterable": true },
    { "name": "rooms", "type": "Edm.Int32", "filterable": true },
    { "name": "views", "type": "Edm.Int64", "filterable": true },
    { "name": "active", "type": "Edm.Boolean", "filterable": true },
    { "name": "updated", "type": "Edm.DateTimeOffset", "filterable": true },
    { "name": "location", "type": "Edm.GeographyPoint", "filterable": true },
    { "name": "tags", "type": "Collection(Edm.String)", "filterable": true },
    { "name": "scores", "type": "Collection(Edm.Double)", "filterable": true },
    {
      "name": "address", "type": "Edm.ComplexType",
      "fields": [
        { "name": "street", "type": "Edm.String" },
        { "name": "city", "type": "Edm.String", "filterable": true },
        { "name": "zip", "type": "Edm.String" }
      ]
    },
    {
      "name": "contacts", "type": "Collection(Edm.ComplexType)",
      "fields": [{ "name": "name", "type": "Edm.String" }, { "name": "phone", "type": "Edm.String" }]
    }
  ]
}

# =====================================================
# 2. UPLOAD, LOOK UP AND MERGE
# =====================================================

### Upload a full document and a minimal one (each item's status is 201: created)
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [
    {
      "@search.action": "upload", "id": "1", "name": "Ocean View Hotel", "rating": 4.5, "rooms": 120,
      "views": 9223372036854775807, "active": true, "updated": "2024-03-05T10:20:30.1234567+02:00",
      "location": { "type": "Point", "coordinates": [2.35, 48.85] },
      "tags": ["pool", "spa"], "scores": [1.5, 2.5],
      "address": { "street": "1 Rue de la Paix", "city": "Paris", "zip": "75001" },
      "contacts": [{ "name": "Front desk", "phone": "+33 1 00 00 00 00" }]
    },
    { "@search.action": "upload", "id": "2", "name": "Budget Inn" }
  ]
}

### Upload document 2 again (its status is 200: replaced)
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "2", "name": "Budget Inn Express" }]
}

### Look up the minimal document: every retrievable field is returned, null when missing and [] for collections
GET {{baseUrl}}/indexes/document-sample/docs/2?api-version={{apiVersion}}
api-key: {{queryKey}}

### Look up the full document: dates come back in UTC to the millisecond (2024-03-05T08:20:30.123Z), and points with their crs (EPSG:4326)
GET {{baseUrl}}/indexes/document-sample/docs/1?api-version={{apiVersion}}
api-key: {{queryKey}}

### $select can name sub-fields of complex fields
GET {{baseUrl}}/indexes/document-sample/docs/1?api-version={{apiVersion}}&$select=name,address/city
api-key: {{queryKey}}

### Merge into a complex field: the other sub-fields are kept, and collections are replaced
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "merge", "id": "1", "address": { "zip": "75002" }, "tags": ["rooftop"] }]
}

### Look up the merged document: address keeps its street and city, and tags is ["rooftop"]
GET {{baseUrl}}/indexes/document-sample/docs/1?api-version={{apiVersion}}&$select=address,tags
api-key: {{queryKey}}

### Values are converted to their field's type: special doubles in any case, numbers and booleans in strings, a date alone, a point with an altitude
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [
    {
      "@search.action": "mergeOrUpload", "id": "3", "rating": "nan", "rooms": " 42 ", "views": 7.5, "active": "True",
      "scores": ["INF", 1.5, "-Inf"], "updated": "2024-03-05", "location": { "type": "Point", "coordinates": [-122.13, 47.67, 30] }
    }
  ]
}

### Look up document 3: "NaN", 42, 8 (an Edm.Int64 rounds a fraction half to even), true, ["INF", 1.5, "-INF"], 2024-03-05T00:00:00Z, and the point without its altitude
GET {{baseUrl}}/indexes/document-sample/docs/3?api-version={{apiVersion}}&$select=rating,rooms,views,active,scores,updated,location
api-key: {{queryKey}}

### Delete document 3
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "delete", "id": "3" }]
}

# =====================================================
# 3. BATCHES AZURE REJECTS (HTTP 400)
# =====================================================
# One invalid action rejects the whole batch before any action is applied.

### A valid action and an invalid one: nothing is written → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [
    { "@search.action": "upload", "id": "4", "name": "Not written" },
    { "@search.action": "upload", "id": "5", "rooms": "many" }
  ]
}

### The valid action wasn't applied either → 404
GET {{baseUrl}}/indexes/document-sample/docs/4?api-version={{apiVersion}}
api-key: {{queryKey}}

### A key with a character other than letters, digits, _, - and = → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "a.b" }]
}

### A key starting with an underscore → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "_a" }]
}

### A missing key → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "name": "No key" }]
}

### A property the index doesn't define → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "stars": 5 }]
}

### A sub-property a complex field doesn't define → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "address": { "floor": 3 } }]
}

### A fraction in an integer field → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "rooms": 1.5 }]
}

### An Edm.Int32 takes integers only, so even 5.0 → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "rooms": 5.0 }]
}

### An Edm.Int64 can't be a string, unlike the other numeric types → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "views": "5" }]
}

### A number out of the field's range (Edm.Int32) → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "rooms": 3000000000 }]
}

### null inside a collection → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "tags": ["pool", null] }]
}

### A date without a Z or an offset → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "updated": "2024-03-05T10:20:30" }]
}

### A geography point that isn't a GeoJSON point → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "location": { "lat": 48.85, "lon": 2.35 } }]
}

### A string that isn't a number in an Edm.Double → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "6", "rating": "five" }]
}

### An unknown @search.action → 400
POST {{baseUrl}}/indexes/document-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "replace", "id": "6" }]
}

# =====================================================
# 4. CLEANUP
# =====================================================

### Delete the index
DELETE {{baseUrl}}/indexes/document-sample?api-version={{apiVersion}}
api-key: {{adminKey}}
