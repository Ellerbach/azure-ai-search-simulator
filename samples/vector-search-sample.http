### =====================================================
### Vector Search Sample Requests
### Demonstrates vector queries: filters applied before the k
### nearest neighbours are taken (preFilter, the default) or after
### (postFilter, strictPostFilter), exact search, ranking by each
### field's metric, hybrid counts and facets, and the vector
### requests Azure AI Search rejects.
### =====================================================
###
### SETUP ORDER:
### 1. Create the index
### 2. Upload the documents
### 3. Query (each title gives the expected ids, or the status)
### 4. Cleanup
###
### Prerequisites:
### - The simulator running at https://localhost:7250
### - REST Client extension for VS Code
### =====================================================

@baseUrl = {{$dotenv BASE_URL}}
@apiVersion = {{$dotenv API_VERSION}}
@adminKey = {{$dotenv ADMIN_KEY}}
@queryKey = {{$dotenv QUERY_KEY}}
# strictPostFilter needs a preview API version in Azure.
@previewApiVersion = 2025-11-01-preview

# =====================================================
# 1. CREATE THE INDEX
# =====================================================

### Create an index with a cosine HNSW field and a euclidean exhaustive KNN field
POST {{baseUrl}}/indexes?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "name": "vector-sample",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": true },
    { "name": "title", "type": "Edm.String", "searchable": true },
    { "name": "category", "type": "Edm.String", "filterable": true, "facetable": true },
    { "name": "embedding", "type": "Collection(Edm.Single)", "searchable": true, "dimensions": 2, "vectorSearchProfile": "cosine-profile" },
    { "name": "position", "type": "Collection(Edm.Single)", "searchable": true, "dimensions": 2, "vectorSearchProfile": "euclidean-profile" }
  ],
  "vectorSearch": {
    "algorithms": [
      { "name": "hnsw-cosine", "kind": "hnsw", "hnswParameters": { "metric": "cosine" } },
      { "name": "exact-euclidean", "kind": "exhaustiveKnn", "exhaustiveKnnParameters": { "metric": "euclidean" } }
    ],
    "profiles": [
      { "name": "cosine-profile", "algorithm": "hnsw-cosine" },
      { "name": "euclidean-profile", "algorithm": "exact-euclidean" }
    ]
  }
}

# =====================================================
# 2. UPLOAD THE DOCUMENTS
# =====================================================

### Upload four documents (by cosine to [1, 0]: 1, 3, 2, 4; by euclidean distance to [1, 0] on position: 2, 1, 4, 3)
POST {{baseUrl}}/indexes/vector-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [
    { "@search.action": "upload", "id": "1", "title": "red apple", "category": "fruit", "embedding": [1, 0], "position": [3, 0] },
    { "@search.action": "upload", "id": "2", "title": "green apple", "category": "fruit", "embedding": [0.8, 0.6], "position": [1, 1] },
    { "@search.action": "upload", "id": "3", "title": "red car", "category": "vehicle", "embedding": [0.95, 0.31], "position": [5, 5] },
    { "@search.action": "upload", "id": "4", "title": "blue car", "category": "vehicle", "embedding": [0, 1], "position": [0, 4] }
  ]
}

# =====================================================
# 3. VECTOR QUERIES
# =====================================================

### A vector query without search text returns only its k nearest neighbours → 1, 3
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 2 }],
  "select": "id, title"
}

### With a filter, the k nearest neighbours are taken among the documents that pass it (preFilter, the default) → 3, 4
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 2 }],
  "filter": "category eq 'vehicle'",
  "select": "id, title"
}

### postFilter takes the k nearest neighbours first, then drops those that don't pass the filter → 3
# The simulator has one shard. Azure takes k neighbours from each shard of the index, so it can also return 4.
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 2 }],
  "filter": "category eq 'vehicle'",
  "vectorFilterMode": "postFilter",
  "select": "id, title"
}

### strictPostFilter takes the k nearest neighbours of the whole index, then filters them → 3
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{previewApiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 2 }],
  "filter": "category eq 'vehicle'",
  "vectorFilterMode": "strictPostFilter",
  "select": "id, title"
}

### exhaustive: true searches every vector exactly instead of the HNSW graph → 1, 3
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 2, "exhaustive": true }],
  "select": "id, title"
}

### A field on an exhaustiveKnn algorithm ranks by its metric, here euclidean distance → 2
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "position", "k": 1 }],
  "select": "id, title"
}

### Hybrid: the text matches plus the vector neighbours; @odata.count and facets cover them all → 1, 3, 4
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "car",
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 1 }],
  "count": true,
  "facets": ["category"],
  "select": "id, title"
}

### A vector-only query's facets count its k neighbours (buckets: fruit 1, vehicle 1) → 1, 3
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 2 }],
  "facets": ["category"],
  "select": "id"
}

# =====================================================
# 4. REQUESTS AZURE REJECTS (HTTP 400)
# =====================================================

### An unknown vectorFilterMode → 400
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 2 }],
  "filter": "category eq 'vehicle'",
  "vectorFilterMode": "midFilter"
}

### An unknown field → 400
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "contentVector", "k": 2 }]
}

### A field that isn't a vector field → 400
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "category", "k": 2 }]
}

### A vector of the wrong length → 400
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0, 0], "fields": "embedding", "k": 2 }]
}

### A vector query without a vector → 400
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "fields": "embedding", "k": 2 }]
}

### A text vector query needs a vectorizer, which the simulator doesn't have → 400
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "text", "text": "red fruit", "fields": "embedding", "k": 2 }]
}

### $orderby is validated for vector-only queries too: a vector field isn't sortable → 400
POST {{baseUrl}}/indexes/vector-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "vectorQueries": [{ "kind": "vector", "vector": [1, 0], "fields": "embedding", "k": 2 }],
  "orderby": "embedding"
}

### Uploading a vector of the wrong length → 400
POST {{baseUrl}}/indexes/vector-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [{ "@search.action": "upload", "id": "5", "title": "short vector", "embedding": [1, 0, 0] }]
}

# =====================================================
# 5. CLEANUP
# =====================================================

### Delete the index
DELETE {{baseUrl}}/indexes/vector-sample?api-version={{apiVersion}}
api-key: {{adminKey}}
