### =====================================================
### Index Update Sample Requests
### Demonstrates which changes to an existing index are applied in
### place and which Azure AI Search refuses (with its messages):
### fields can be added but not deleted or changed (except
### retrievable, searchAnalyzer and synonymMaps), analysis
### components can't change and are only added with
### allowIndexDowntime, suggesters only gain new fields, and vector
### algorithms in use can't change.
### =====================================================
###
### SETUP ORDER:
### 1. Create the index
### 2. Send the updates in order (each title gives the expected status)
### 3. Cleanup
###
### Prerequisites:
### - The simulator running at https://localhost:7250
### - REST Client extension for VS Code
### =====================================================

@baseUrl = {{$dotenv BASE_URL}}
@apiVersion = {{$dotenv API_VERSION}}
@adminKey = {{$dotenv ADMIN_KEY}}

# =====================================================
# 1. CREATE THE INDEX
# =====================================================

### Create an index with a custom analyzer, a suggester and a vector field
PUT {{baseUrl}}/indexes/index-update-sample?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "name": "index-update-sample",
  "fields": [
    {
      "name": "id",
      "type": "Edm.String",
      "key": true,
      "filterable": true
    },
    {
      "name": "title",
      "type": "Edm.String",
      "searchable": true
    },
    {
      "name": "summary",
      "type": "Edm.String",
      "searchable": true
    },
    {
      "name": "category",
      "type": "Edm.String",
      "filterable": true,
      "facetable": true
    },
    {
      "name": "notes",
      "type": "Edm.String",
      "searchable": true,
      "analyzer": "notes_analyzer"
    },
    {
      "name": "embedding",
      "type": "Collection(Edm.Single)",
      "searchable": true,
      "dimensions": 2,
      "vectorSearchProfile": "vector-profile"
    }
  ],
  "suggesters": [
    {
      "name": "sg",
      "searchMode": "analyzingInfixMatching",
      "sourceFields": [
        "title"
      ]
    }
  ],
  "analyzers": [
    {
      "@odata.type": "#Microsoft.Azure.Search.CustomAnalyzer",
      "name": "notes_analyzer",
      "tokenizer": "standard_v2",
      "tokenFilters": [
        "lowercase"
      ]
    }
  ],
  "vectorSearch": {
    "algorithms": [
      {
        "name": "hnsw",
        "kind": "hnsw",
        "hnswParameters": {
          "metric": "cosine",
          "m": 4,
          "efConstruction": 400
        }
      }
    ],
    "profiles": [
      {
        "name": "vector-profile",
        "algorithm": "hnsw"
      }
    ]
  }
}

# =====================================================
# 2. UPDATES
# =====================================================

### Add a field, and make an existing field non-retrievable: both allowed
PUT {{baseUrl}}/indexes/index-update-sample?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "name": "index-update-sample",
  "fields": [
    {
      "name": "id",
      "type": "Edm.String",
      "key": true,
      "filterable": true
    },
    {
      "name": "title",
      "type": "Edm.String",
      "searchable": true,
      "retrievable": false
    },
    {
      "name": "summary",
      "type": "Edm.String",
      "searchable": true
    },
    {
      "name": "category",
      "type": "Edm.String",
      "filterable": true,
      "facetable": true
    },
    {
      "name": "notes",
      "type": "Edm.String",
      "searchable": true,
      "analyzer": "notes_analyzer"
    },
    {
      "name": "embedding",
      "type": "Collection(Edm.Single)",
      "searchable": true,
      "dimensions": 2,
      "vectorSearchProfile": "vector-profile"
    },
    {
      "name": "rating",
      "type": "Edm.Double",
      "filterable": true,
      "sortable": true
    }
  ],
  "suggesters": [
    {
      "name": "sg",
      "searchMode": "analyzingInfixMatching",
      "sourceFields": [
        "title"
      ]
    }
  ],
  "analyzers": [
    {
      "@odata.type": "#Microsoft.Azure.Search.CustomAnalyzer",
      "name": "notes_analyzer",
      "tokenizer": "standard_v2",
      "tokenFilters": [
        "lowercase"
      ]
    }
  ],
  "vectorSearch": {
    "algorithms": [
      {
        "name": "hnsw",
        "kind": "hnsw",
        "hnswParameters": {
          "metric": "cosine",
          "m": 4,
          "efConstruction": 400
        }
      }
    ],
    "profiles": [
      {
        "name": "vector-profile",
        "algorithm": "hnsw"
      }
    ]
  }
}

