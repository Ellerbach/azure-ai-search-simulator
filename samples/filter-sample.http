      ]
    },
    {
      "@search.action": "upload",
      "id": "2", "name": "City Budget Inn", "category": "Budget", "rating": 3.0, "distanceKm": "INF",
      "opened": "2021-01-01T00:00:00Z", "isActive": false,
      "tags": ["wifi"], "roomNumbers": [201],
