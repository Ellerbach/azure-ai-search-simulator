  ]
}

# =====================================================
# 3. FILTERS
# =====================================================
# Each filter is evaluated exactly against every document. Conditions inside
# one any()/all() hold for the same element of the collection.

### [SIM] Lambda over a complex collection: one room that is Deluxe AND has 2+ beds → 1
# Hotel 3 has a Deluxe room and a 4-bed room, but not one room that is both.
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "rooms/any(r: r/type eq 'Deluxe' and r/beds ge 2)",
  "select": "id"
}

### [AZURE] Lambda over a complex collection: one room that is Deluxe AND has 2+ beds → 1
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "rooms/any(r: r/type eq 'Deluxe' and r/beds ge 2)",
  "select": "id"
}

### [SIM] Nested lambdas: a room with a minibar → 1
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "rooms/any(r: r/amenities/any(a: a eq 'minibar'))",
  "select": "id"
}

### [AZURE] Nested lambdas: a room with a minibar → 1
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "rooms/any(r: r/amenities/any(a: a eq 'minibar'))",
  "select": "id"
}

### [SIM] all() over a complex collection: every room is non-smoking → 2, 3, 4
# all() over an empty collection is true, so hotel 4 (no rooms) matches.
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "rooms/all(r: not r/smoking)",
  "select": "id"
}

### [AZURE] all() over a complex collection: every room is non-smoking → 2, 3, 4
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "rooms/all(r: not r/smoking)",
  "select": "id"
}

### [SIM] any() without a lambda: hotels that have rooms → 1, 2, 3
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "rooms/any()",
  "select": "id"
}

### [AZURE] any() without a lambda: hotels that have rooms → 1, 2, 3
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "rooms/any()",
  "select": "id"
}

### [SIM] and, or and parentheses → 1, 4
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "(category eq 'Resort' and rating ge 4) or category eq 'Luxury'",
  "select": "id"
}

### [AZURE] and, or and parentheses → 1, 4
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "(category eq 'Resort' and rating ge 4) or category eq 'Luxury'",
  "select": "id"
}

### [SIM] A missing value is null → 3
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "rating eq null",
  "select": "id"
}

### [AZURE] A missing value is null → 3
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "rating eq null",
  "select": "id"
}

### [SIM] A boolean field on its own, negated → 2
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "not isActive",
  "select": "id"
}

### [AZURE] A boolean field on its own, negated → 2
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "not isActive",
  "select": "id"
}

### [SIM] A complex sub-field with a lowercase normalizer, applied to both sides → 1, 2
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "address/city eq 'PARIS' and address/country eq 'France'",
  "select": "id"
}

### [AZURE] A complex sub-field with a lowercase normalizer, applied to both sides → 1, 2
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "address/city eq 'PARIS' and address/country eq 'France'",
  "select": "id"
}

### [SIM] search.in with a custom delimiter → 1, 3, 4
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "search.in(category, 'Resort|Luxury', '|')",
  "select": "id"
}

### [AZURE] search.in with a custom delimiter → 1, 3, 4
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "search.in(category, 'Resort|Luxury', '|')",
  "select": "id"
}

### [SIM] String collection, any(): equality joined with or → 1, 4
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "tags/any(t: t eq 'pool' or t eq 'spa')",
  "select": "id"
}

### [AZURE] String collection, any(): equality joined with or → 1, 4
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "tags/any(t: t eq 'pool' or t eq 'spa')",
  "select": "id"
}

### [SIM] String collection, all(): inequality joined with and → 1, 3, 4
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "tags/all(t: t ne 'wifi')",
  "select": "id"
}

### [AZURE] String collection, all(): inequality joined with and → 1, 3, 4
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "tags/all(t: t ne 'wifi')",
  "select": "id"
}

### [SIM] Number collection, any(): a range on one element → 3
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "roomNumbers/any(n: n ge 300 and n lt 400)",
  "select": "id"
}

### [AZURE] Number collection, any(): a range on one element → 3
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "roomNumbers/any(n: n ge 300 and n lt 400)",
  "select": "id"
}

### [SIM] Dates need a time and a Z or an offset → 2, 4
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "opened ge 2020-01-01T00:00:00Z",
  "select": "id"
}

### [AZURE] Dates need a time and a Z or an offset → 2, 4
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "opened ge 2020-01-01T00:00:00Z",
  "select": "id"
}

### [SIM] Dates compare to the millisecond, as Azure stores them → 1
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "opened eq 2019-05-01T10:00:00.1239999Z",
  "select": "id"
}

### [AZURE] Dates compare to the millisecond, as Azure stores them → 1
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "opened eq 2019-05-01T10:00:00.1239999Z",
  "select": "id"
}

### [SIM] Stored "INF" compares as infinity → 2
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "distanceKm gt 1e300",
  "select": "id"
}

### [AZURE] Stored "INF" compares as infinity → 2
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "distanceKm gt 1e300",
  "select": "id"
}

### [SIM] Stored "NaN" compares unequal to everything, so only ne matches it → 1, 2, 3
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "distanceKm ne 0",
  "select": "id"
}

### [AZURE] Stored "NaN" compares unequal to everything, so only ne matches it → 1, 2, 3
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "distanceKm ne 0",
  "select": "id"
}

### [SIM] search.ismatch runs a text query; comparing it with false negates it → 2, 3, 4
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "search.ismatch('ocean', 'name') eq false",
  "select": "id"
}

### [AZURE] search.ismatch runs a text query; comparing it with false negates it → 2, 3, 4
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "search.ismatch('ocean', 'name') eq false",
  "select": "id"
}

### [SIM] A filter narrows the results without changing their scores → 1
# @search.score is the same as for the search without the filter.
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "hotel",
  "filter": "category eq 'Resort'",
  "select": "id, name"
}

### [AZURE] A filter narrows the results without changing their scores → 1
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "hotel",
  "filter": "category eq 'Resort'",
  "select": "id, name"
}

### [SIM] Strings compare ordinally, so "Mountain Lodge" and "Ocean View Hotel" come after "M" → 1, 3
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "name gt 'M'",
  "select": "id, name"
}

### [AZURE] Strings compare ordinally, so "Mountain Lodge" and "Ocean View Hotel" come after "M" → 1, 3
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "name gt 'M'",
  "select": "id, name"
}

# =====================================================
# 4. FILTERS AZURE REJECTS (HTTP 400)
# =====================================================
# A filter the service can't evaluate exactly is an error, never a clause
# that is silently ignored.

### [SIM] Ordering comparisons on booleans → 400
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "isActive gt false"
}

### [AZURE] Ordering comparisons on booleans → 400
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "isActive gt false"
}

### [SIM] A field that isn't filterable → 400
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "notes eq 'Renovated lobby'"
}

### [AZURE] A field that isn't filterable → 400
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "notes eq 'Renovated lobby'"
}

### [SIM] A constant of the wrong type → 400
POST {{baseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{queryKey}}

{
  "search": "*",
  "filter": "rating eq '4.5'"
}

### [AZURE] A constant of the wrong type → 400
POST {{azureBaseUrl}}/indexes/filter-sample/docs/search?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "search": "*",
  "filter": "rating eq '4.5'"
}

