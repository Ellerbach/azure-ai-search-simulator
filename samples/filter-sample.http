### =====================================================
### Filter Sample Requests ($filter)
### Demonstrates how $filter is evaluated: and/or/not, null,
### complex paths, any()/all() lambdas (correlated per element and
### nested), search.in, search.ismatch, dates, doubles and
### normalizers, plus the filters Azure AI Search rejects with 400.
### =====================================================
###
### SETUP ORDER:
### 1. Create the index
### 2. Upload the documents
### 3. Run the filters (each title gives the expected ids, or the status)
### 4. Cleanup
###
### Prerequisites:
### - The simulator running at https://localhost:7250
### - REST Client extension for VS Code
### - For the [AZURE] requests: an Azure AI Search service with role-based
###   access, the Search Service Contributor and Search Index Data Contributor
###   roles, and AZURE_BASE_URL and ENTRA_TOKEN in .env (see .env.example).
###   To use keys instead, replace "Authorization: Bearer {{azureToken}}"
###   with an api-key header.
### - Each request is a [SIM]/[AZURE] pair; run the steps in order on each.
### =====================================================

@baseUrl = {{$dotenv BASE_URL}}
@apiVersion = {{$dotenv API_VERSION}}
@adminKey = {{$dotenv ADMIN_KEY}}
@queryKey = {{$dotenv QUERY_KEY}}
@azureBaseUrl = {{$dotenv AZURE_BASE_URL}}
@azureToken = {{$dotenv ENTRA_TOKEN}}

# =====================================================
# 1. CREATE THE INDEX
# =====================================================

### [SIM] Create an index with simple, collection and complex fields
POST {{baseUrl}}/indexes?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "name": "filter-sample",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": true },
    { "name": "name", "type": "Edm.String", "searchable": true, "filterable": true, "sortable": true },
    { "name": "category", "type": "Edm.String", "filterable": true, "facetable": true },
    { "name": "rating", "type": "Edm.Double", "filterable": true, "sortable": true },
    { "name": "distanceKm", "type": "Edm.Double", "filterable": true },
    { "name": "opened", "type": "Edm.DateTimeOffset", "filterable": true, "sortable": true },
    { "name": "isActive", "type": "Edm.Boolean", "filterable": true },
    { "name": "notes", "type": "Edm.String", "searchable": true, "filterable": false },
    { "name": "tags", "type": "Collection(Edm.String)", "filterable": true },
    { "name": "roomNumbers", "type": "Collection(Edm.Int32)", "filterable": true },
    {
      "name": "address", "type": "Edm.ComplexType",
      "fields": [
        { "name": "city", "type": "Edm.String", "filterable": true, "normalizer": "lowercase" },
        { "name": "country", "type": "Edm.String", "filterable": true }
      ]
    },
    {
      "name": "rooms", "type": "Collection(Edm.ComplexType)",
      "fields": [
        { "name": "type", "type": "Edm.String", "filterable": true },
        { "name": "beds", "type": "Edm.Int32", "filterable": true },
        { "name": "smoking", "type": "Edm.Boolean", "filterable": true },
        { "name": "amenities", "type": "Collection(Edm.String)", "filterable": true }
      ]
    }
  ]
}

### [AZURE] Create an index with simple, collection and complex fields
POST {{azureBaseUrl}}/indexes?api-version={{apiVersion}}
Content-Type: application/json
Authorization: Bearer {{azureToken}}

{
  "name": "filter-sample",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": true },
    { "name": "name", "type": "Edm.String", "searchable": true, "filterable": true, "sortable": true },
    { "name": "category", "type": "Edm.String", "filterable": true, "facetable": true },
    { "name": "rating", "type": "Edm.Double", "filterable": true, "sortable": true },
    { "name": "distanceKm", "type": "Edm.Double", "filterable": true },
    { "name": "opened", "type": "Edm.DateTimeOffset", "filterable": true, "sortable": true },
    { "name": "isActive", "type": "Edm.Boolean", "filterable": true },
    { "name": "notes", "type": "Edm.String", "searchable": true, "filterable": false },
    { "name": "tags", "type": "Collection(Edm.String)", "filterable": true },
    { "name": "roomNumbers", "type": "Collection(Edm.Int32)", "filterable": true },
    {
      "name": "address", "type": "Edm.ComplexType",
      "fields": [
        { "name": "city", "type": "Edm.String", "filterable": true, "normalizer": "lowercase" },
        { "name": "country", "type": "Edm.String", "filterable": true }
      ]
    },
    {
      "name": "rooms", "type": "Collection(Edm.ComplexType)",
      "fields": [
        { "name": "type", "type": "Edm.String", "filterable": true },
        { "name": "beds", "type": "Edm.Int32", "filterable": true },
        { "name": "smoking", "type": "Edm.Boolean", "filterable": true },
        { "name": "amenities", "type": "Collection(Edm.String)", "filterable": true }
      ]
    }
  ]
}

# =====================================================
# 2. UPLOAD THE DOCUMENTS
# =====================================================

### [SIM] Upload four hotels (hotel 3 has no rating; distanceKm holds "INF" and "NaN")
POST {{baseUrl}}/indexes/filter-sample/docs/index?api-version={{apiVersion}}
Content-Type: application/json
api-key: {{adminKey}}

{
  "value": [
    {
      "@search.action": "upload",
      "id": "1", "name": "Ocean View Hotel", "category": "Resort", "rating": 4.5, "distanceKm": 2.5,
      "opened": "2019-05-01T10:00:00.123Z", "isActive": true, "notes": "Renovated lobby",
      "tags": ["pool", "spa"], "roomNumbers": [101, 102],
      "address": { "city": "Paris", "country": "France" },
      "rooms": [
        { "type": "Deluxe", "beds": 2, "smoking": false, "amenities": ["tv", "minibar"] },
        { "type": "Standard", "beds": 1, "smoking": true, "amenities": ["tv"] }
      ]
    },
    {
      "@search.action": "upload",
      "id": "2", "name": "City Budget Inn", "category": "Budget", "rating": 3.0, "distanceKm": "INF",
      "opened": "2021-01-01T00:00:00Z", "isActive": false,
      "tags": ["wifi"], "roomNumbers": [201],
      "address": { "city": "PARIS", "country": "France" },
      "rooms": [{ "type": "Standard", "beds": 2, "smoking": false, "amenities": [] }]
    },
    {
      "@search.action": "upload",
      "id": "3", "name": "Mountain Lodge", "category": "Resort", "distanceKm": "NaN",
      "opened": "2015-07-15T08:30:00Z", "isActive": true,
      "tags": [], "roomNumbers": [301, 302],
      "address": { "city": "Lyon", "country": "France" },
      "rooms": [
        { "type": "Deluxe", "beds": 1, "smoking": false, "amenities": ["fireplace"] },
        { "type": "Suite", "beds": 4, "smoking": false, "amenities": ["tv"] }
      ]
    },
    {
      "@search.action": "upload",
      "id": "4", "name": "Harbor Suites", "category": "Luxury", "rating": 5.0, "distanceKm": 0,
      "opened": "2023-03-10T12:00:00Z", "isActive": true,
      "tags": ["pool"], "roomNumbers": [],
      "address": { "city": "Nice", "country": "France" },
      "rooms": []
    }
  ]
}

